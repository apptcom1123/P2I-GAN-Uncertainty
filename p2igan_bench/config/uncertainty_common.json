      "h": 128,
      "sample_length": 16,
      "mask": {
        "type": "stis",
        "keep": 4,
        "block_sizes": [10],
        "interval": [2, 3, 4, 5, 6],
        "file": "/home/NAS/homes/brick-10015/INGAN/core/rain_gauge_mask_1024_train.txt"
      }
    },
    "valid": {
      "data_root": "/home/NAS/house/brick-10015/Nimrod_2d_data/NIMROD_Train_datasets_sti/test",
      "shuffle": false
    },
    "test": {
      "data_root": "/home/NAS/house/brick-10015/Nimrod_2d_data/NIMROD_Train_datasets_sti/val",
      "w": 128,
      "h": 128,
      "mask": {
        "type": "stis",
        "keep": 4,
        "block_sizes": [10],
        "interval": [2, 3, 4, 5, 6],
        "file": "/home/NAS/homes/brick-10015/INGAN/core/rain_gauge_mask_1024_train.txt"
      },
      "shuffle": false
    }
  },
  "loss": {
    "beta": 0.0,
    "k1_weight": 0.0005,
    "lambda_uncertainty_temporal": 0.0005,
    "lambda_pm": 0.0,
    "pm_omega": 10.0,
    "lambda_adv_field": 0.01,
    "gan_loss": "hinge",
    "logvar_clamp_min": -10.0,
    "logvar_clamp_max": 8.0
  },
  "uncertainty": {
    "train_samples": 4,
    "val_samples": 8,
    "predict_samples": 16,
    "ensemble_size": 48,
    "correlated_noise": {"enabled": true, "temporal_mode": "per_frame"}
  },
  "train": {
    "optimizer": {"type": "Adam", "beta1": 0.0, "beta2": 0.99, "lr": 0.0001},
